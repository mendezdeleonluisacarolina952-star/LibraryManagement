    {
      "name": "E11-04 - Registrar un libro",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const isbn = '978' + Date.now().toString().slice(-10);",
              "pm.collectionVariables.set('testIsbn', isbn);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"E11-04: alta exitosa HTTP 200 o 201\", function () {",
              "  pm.expect([200, 201], \"El backend rechazo el registro: HTTP \" + pm.response.code + \" - \" + pm.response.text()).to.include(pm.response.code);",
              "});",
              "pm.test(\"E11-04: la respuesta de alta es JSON\", function () {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\", \"Respuesta recibida: \" + pm.response.text()).to.include(\"application/json\");",
              "  pm.response.to.be.json;",
              "});",
              "pm.test(\"E11-04: devuelve ID del libro creado\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.success).to.eql(true);",
              "  pm.expect(data.newBook).to.be.an(\"object\");",
              "  pm.expect(data.newBook._id).to.exist;",
              "  pm.collectionVariables.set(\"createdBookId\", String(data.newBook._id));",
              "});"
            ]
          }
        }
      ],
