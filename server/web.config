<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Indica a IIS que use el módulo iisnode para manejar index.js -->
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No reescribir peticiones a archivos/carpetas que sí existen -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(?!index\.js).*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Todo lo demás va a index.js (tu servidor Express) -->
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Evita que IIS sirva index.js como archivo estático descargable -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <iisnode watchedFiles="web.config;*.js" />
  </system.webServer>
</configuration>
